# Copy this file to .env and fill it in. Never commit .env.

# development | production   (production refuses to start with the default JWT secret)
ENV=development

# Local: a file next to the app. Production: your Supabase or Neon Postgres URL, e.g.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./crunch.db

# A long random string. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

# Websites allowed to call the API from another domain (comma separated).
# Not needed when the API serves the websites itself (the Docker setup).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SHOP_TIMEZONE=Asia/Kolkata

# Optional: create the first owner on first start (remove the password afterwards)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner

# AI assistant. "basic" needs no key. Free options:
#   openrouter   AI_API_KEY from openrouter.ai, AI_MODEL = any model id ending in ":free" that supports tools
#   ollama       runs on your own computer, AI_MODEL=llama3.1 (or qwen2.5)
#   huggingface  AI_API_KEY = a Hugging Face token, AI_MODEL = a chat model that supports tools
#   custom       any OpenAI-compatible endpoint: set AI_BASE_URL too
AI_PROVIDER=basic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
